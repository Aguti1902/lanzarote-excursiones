# Opcional: si añades una clave de OpenAI, el chat usará IA real.
# Sin ella, responde con el asistente local basado en el contenido de la web.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Stripe (pagos / devoluciones). Sin STRIPE_SECRET_KEY las cancelaciones
# emiten abono y simulan el reembolso en modo demo.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
